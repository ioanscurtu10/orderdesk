{
  "name": "@orderdesk/vue-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OrderDesk front-end in Vue 3 (Composition API), TypeScript, Pinia, Vue Router, Vuetify 3, vue-i18n.",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@orderdesk/shared": "*",
    "axios": "^1.12.0",
    "echarts": "^5.6.0",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.2",
    "papaparse": "^5.5.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.9.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^26.1.0",
    "resize-observer-polyfill": "^1.5.1",
    "vite": "^7.1.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
